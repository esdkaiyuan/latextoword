{
  "name": "latex-to-word-workbench",
  "version": "0.1.0",
  "description": "Offline LaTeX formula workbench for Microsoft Word",
  "main": "src/main/main.cjs",
  "author": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -p tsconfig.json && vite build",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fluentui/react-components": "^9.70.0",
    "@fluentui/react-icons": "^2.0.319",
    "@fontsource/libertinus-math": "^5.3.0",
    "@fontsource/noto-sans-math": "^5.3.0",
    "@fontsource/stix-two-math": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@uiw/react-codemirror": "^4.23.8",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "html-to-docx": "^1.8.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.2",
    "markdown-it-texmath": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^38.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.formulaworkbench.desktop",
    "productName": "公式工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ocr-worker",
        "to": "ocr-worker",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
